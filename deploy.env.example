# 复制为 .env，或由 scripts/deploy_windows.ps1 通过参数自动生成。
# 不要把真实密钥提交到版本库。

# 必填：AutoWeb 当前使用百炼兼容 OpenAI API 配置。
BAILIAN_MODEL_NAME=
BAILIAN_API_KEY=
BAILIAN_BASE_URL=

# 可选：只有使用 RAG 时才需要可访问的 Milvus。
MILVUS_URI=http://localhost:19530

# 浏览器与 dp_cli 受控执行链路。
HEADLESS_MODE=True
DPCLI_ENABLED=True
DPCLI_CWD=
DPCLI_PYTHON=
DPCLI_HEADLESS=True
DPCLI_TIMEOUT_SECONDS=60
DPCLI_BATCH_TIMEOUT_SECONDS=900
DPCLI_OBSERVER_ENABLED=True
DPCLI_OBSERVER_FALLBACK_TO_DOM=True

# 安全与可恢复性默认值。
SESSION_STRUCTURED_FALLBACK_ENABLED=True
SITE_POLICY_ENABLED=True
SITE_POLICY_MIN_INTERVAL_SECONDS=0.5
SITE_POLICY_MAX_REQUESTS_PER_DOMAIN=240
SITE_POLICY_REQUEST_WINDOW_SECONDS=3600
SITE_POLICY_COOLDOWN_SECONDS=300
TASK_RUN_PERSISTENCE_ENABLED=True
RUN_TRACE_ENABLED=True
